# Токен бота от @BotFather. Один и тот же токен работает и для приёма книг, и для
# уведомлений из Colab — они приходят в тот же чат.
TELEGRAM_BOT_TOKEN=123456789:AA...ваш_токен...

# Кому отвечать. Необязательно: если пусто, владельцем станет тот, кто первым напишет боту.
# Несколько человек — через запятую.
TELEGRAM_CHAT_ID=

# Ускоритель Colab и папка на Google Drive.
GPU=T4
DRIVE_DIR=Audiobooks-colab

# Книги длиннее этого числа часов режутся на части (0 — не резать).
SHRINK_HOURS=7

# Сколько сборок одновременно. У бесплатного тарифа машина одна — оставьте 1.
MAX_JOBS=1
